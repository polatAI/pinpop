# ─────────────────────────────────────────────────────────────
# Pinpop configuration. Copy to `.env` and adjust.
# Every variable is optional unless marked REQUIRED for production.
# ─────────────────────────────────────────────────────────────

# Public address people use to reach Pinpop (used for links, QR codes, OAuth callbacks
# and secure cookies). REQUIRED in production, e.g. https://quiz.example.com
PUBLIC_URL=http://localhost:3000

# Secret used to encrypt stored API keys. REQUIRED in production: generate one with
#   openssl rand -hex 32
# If empty, a random secret is generated once and stored in DATA_DIR/.secret
APP_SECRET=

# Name shown in the UI and API
INSTANCE_NAME=Pinpop

# Port and host the server listens on
PORT=3000
HOST=0.0.0.0

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik, Cloudflare…)
TRUST_PROXY=false

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# ── Storage ──────────────────────────────────────────────────
# PostgreSQL connection string. If empty, Pinpop uses an SQLite database file
# stored in DATA_DIR — perfect for small installs and trying things out.
DATABASE_URL=
# Password for the bundled Postgres container (docker-compose.yml only)
POSTGRES_PASSWORD=change-me

# Where uploads, the embedded database and the generated secret are stored
DATA_DIR=./data
# Maximum image upload size in MB
UPLOAD_MAX_MB=5

# ── Accounts ─────────────────────────────────────────────────
# Allow anyone to sign up. When false, only the first (admin) account can be created.
ALLOW_REGISTRATION=true

# Optional OAuth login. Callback URLs: {PUBLIC_URL}/api/auth/oauth/github/callback
#                                     {PUBLIC_URL}/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Games ────────────────────────────────────────────────────
MAX_PLAYERS=500
MAX_GAMES=1000

# ── AI question generation ───────────────────────────────────
# Provider used for everyone on this server: anthropic | openai | openrouter | ollama | openai-compatible
# Leave empty to disable server-wide AI (users can still add their own keys if allowed below).
AI_PROVIDER=
AI_API_KEY=
# Defaults: anthropic → claude-opus-5-5, openai → gpt-5-mini, openrouter → anthropic/claude-opus-5-5, ollama → llama3.2
AI_MODEL=
# Needed for ollama (default http://localhost:11434/v1) and openai-compatible providers
AI_BASE_URL=
# Let users bring their own AI keys (stored encrypted)
AI_ALLOW_USER_KEYS=true
# Max AI generations per user per day using the server key (0 = unlimited)
AI_DAILY_LIMIT=0

# ── Hosted mode ──────────────────────────────────────────────
# Marks this instance as a public hosted service (shown in the UI); combine with AI_DAILY_LIMIT.
HOSTED_MODE=false
